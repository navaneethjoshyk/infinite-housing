# Copy this file to .env and fill in your values
# NEVER commit .env to GitHub — it contains secrets!

# Get this from MongoDB Atlas → Connect → Drivers
# Format: mongodb+srv://username:password@cluster.mongodb.net/infinite-housing
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/infinite-housing

# Make this a long random string — used to sign JWT tokens
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_key_here_make_it_long_and_random
